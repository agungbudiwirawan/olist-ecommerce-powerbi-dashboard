	column delivery_days = IF ( ISBLANK ( fact_order_items[order_delivered_customer_date] ), BLANK (), ( fact_order_items[order_delivered_customer_date] - fact_order_items[order_purchase_timestamp] ) * 1.0 )
		dataType: double
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 63e39293-d5b7-45cd-9e94-fc77fb2d07a2
		summarizeBy: none

	column days_to_carrier = IF ( ISBLANK ( fact_order_items[order_delivered_carrier_date] ), BLANK (), ( fact_order_items[order_delivered_carrier_date] - fact_order_items[order_purchase_timestamp] ) * 1.0 )
		dataType: double
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 36912322-1ec1-4995-8c71-4a077f1fed41
		summarizeBy: none

	column estimated_days = IF ( ISBLANK ( fact_order_items[order_estimated_delivery_date] ), BLANK (), ( fact_order_items[order_estimated_delivery_date] - fact_order_items[order_purchase_timestamp] ) * 1.0 )
		dataType: double
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 4dcec6ce-7e88-40fe-b07b-3934484a4898
		summarizeBy: none

	column days_late = IF ( ISBLANK ( fact_order_items[order_delivered_customer_date] ) || ISBLANK ( fact_order_items[order_estimated_delivery_date] ), BLANK (), INT ( fact_order_items[order_delivered_customer_date] ) - INT ( fact_order_items[order_estimated_delivery_date] ) )
		dataType: int64
		displayFolder: Delivery
		lineageTag: 874d0d38-fb5e-42f3-9e40-8468866cfeb4
		summarizeBy: none

	column delivery_status =
			VAR d = fact_order_items[days_late]
			RETURN SWITCH ( TRUE (), ISBLANK ( d ), "Not delivered", d > 0, "Late", "On time" )
		dataType: string
		displayFolder: Delivery
		lineageTag: 3e7c730c-236f-414c-a806-f5b02b46625a
		summarizeBy: none

	column delivery_speed_band =
			VAR d = fact_order_items[delivery_days]
			RETURN SWITCH ( TRUE (), ISBLANK ( d ), "Not delivered", d <= 7, "0-7 days", d <= 14, "8-14 days", d <= 21, "15-21 days", d <= 30, "22-30 days", "30+ days" )
		dataType: string
		displayFolder: Delivery
		lineageTag: 6330d59f-d738-46f0-aa35-6d322822651c
		summarizeBy: none
		sortByColumn: delivery_speed_band_sort

	column delivery_speed_band_sort =
			VAR d = fact_order_items[delivery_days]
			RETURN SWITCH ( TRUE (), ISBLANK ( d ), 6, d <= 7, 1, d <= 14, 2, d <= 21, 3, d <= 30, 4, 5 )
		dataType: int64
		isHidden
		lineageTag: 7d8a0630-2b15-4526-9195-64248c5f17da
		summarizeBy: none

